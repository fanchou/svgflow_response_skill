    ],
    "legends": [
      { "label": "Owner", "tone": "blue" },
      { "label": "Build", "tone": "purple" },
      { "label": "Run", "tone": "green" }
    ]
  },
  "layout": {
    "intent": "swimlane",
    "direction": "LR",
    "density": "standard",
    "nodeLimit": 12
  },
  "style": {
    "theme": "official_dark",
    "palette": ["gray", "blue", "purple", "green", "amber"],
    "cornerRadius": 8
  },
  "interactions": [
    {
      "target": "triage",
