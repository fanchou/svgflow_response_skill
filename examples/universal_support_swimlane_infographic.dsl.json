{
  "meta": {
    "title": "Support Workflow Swimlane",
    "description": "A universal swimlane workflow across customer, support, engineering, and operations lanes.",
    "diagramType": "infographic",
    "mode": "preview_svg",
    "locale": "en-US",
    "textDirection": "ltr"
  },
  "canvas": {
    "width": 680,
    "height": 560,
    "background": "official_dark"
  },
  "content": {
    "nodes": [
      { "id": "report", "title": "Report issue", "subtitle": "Customer", "kind": "entity", "tone": "gray" },
      { "id": "triage", "title": "Triage", "subtitle": "Support", "kind": "process", "tone": "blue" },
      { "id": "fix", "title": "Fix defect", "subtitle": "Engineering", "kind": "process", "tone": "purple" },
      { "id": "deploy", "title": "Deploy fix", "subtitle": "Operations", "kind": "process", "tone": "green" },
      { "id": "close", "title": "Close loop", "subtitle": "Support updates customer", "kind": "output", "tone": "amber" }
