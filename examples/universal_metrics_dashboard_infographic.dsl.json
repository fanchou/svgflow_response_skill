        "to": "action",
        "label": "Mitigate",
        "kind": "primary"
      }
    ],
    "labels": [
      {
        "text": "Dashboard intent favors scanning over dense routing.",
        "for": "kpis",
        "tone": "neutral"
      }
    ],
    "legends": [
      {
        "label": "Healthy",
        "tone": "green"
      },
      {
        "label": "Watch",
        "tone": "amber"
      },
      {
        "label": "Risk",
        "tone": "coral"
      }
    ]
  },
  "layout": {
    "intent": "dashboard",
    "direction": "TB",
    "density": "compact",
    "nodeLimit": 12
  },
  "style": {
    "theme": "official_dark",
    "palette": ["green", "blue", "amber", "coral", "purple"],
    "cornerRadius": 8
  },
  "interactions": [
    {
      "target": "incident",
