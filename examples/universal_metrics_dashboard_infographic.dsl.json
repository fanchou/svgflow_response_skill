{
  "meta": {
    "title": "Operational Metrics Dashboard Infographic",
    "description": "A universal infographic for status, KPI, alert, and recommendation cards.",
    "diagramType": "infographic",
    "mode": "preview_svg",
    "locale": "en-US",
    "textDirection": "ltr"
  },
  "canvas": {
    "width": 680,
    "height": 480,
    "background": "official_dark"
  },
  "content": {
    "nodes": [
      {
        "id": "uptime",
        "title": "99.95%",
        "subtitle": "Uptime",
        "kind": "metric",
        "tone": "green"
      },
      {
        "id": "latency",
        "title": "128 ms",
        "subtitle": "P95 latency",
        "kind": "metric",
        "tone": "blue"
      },
      {
        "id": "errors",
        "title": "0.18%",
        "subtitle": "Error rate",
        "kind": "metric",
        "tone": "amber"
      },
      {
        "id": "incident",
        "title": "Active incident",
        "subtitle": "Queue pressure rising",
        "kind": "risk",
        "tone": "coral"
      },
      {
        "id": "action",
        "title": "Scale workers",
        "subtitle": "Recommended next step",
        "kind": "recommendation",
        "tone": "purple"
