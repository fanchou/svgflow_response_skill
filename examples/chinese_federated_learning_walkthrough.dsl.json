      { "id": "amber", "fill": "#633806", "stroke": "#EF9F27", "title": "#FAC775", "text": "#EF9F27" },
      { "id": "gray", "fill": "#444441", "stroke": "#B4B2A9", "title": "#D3D1C7", "text": "#B4B2A9" }
