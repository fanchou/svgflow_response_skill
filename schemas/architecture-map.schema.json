{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/svgflow/architecture-map.schema.json",
  "title": "Architecture Map DSL",
  "type": "object",
  "required": ["meta", "theme", "layers"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["title", "description", "diagramType", "mode", "locale", "textDirection", "viewBox"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "diagramType": { "const": "architecture_map" },
        "mode": { "enum": ["preview_svg", "html_preview", "component_ready"] },
        "locale": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$" },
        "textDirection": { "enum": ["ltr", "rtl", "auto"] },
        "viewBox": {
          "type": "object",
          "required": ["width", "height"],
          "properties": {
            "width": { "const": 680 },
            "height": { "type": "integer", "minimum": 480, "maximum": 1200 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "theme": {
      "type": "object",
      "required": ["palette"],
      "properties": {
        "palette": {
          "type": "array",
          "minItems": 4,
          "maxItems": 12,
          "items": { "$ref": "#/$defs/paletteEntry" }
        }
      },
      "additionalProperties": false
    },
    "layers": {
      "type": "array",
      "minItems": 3,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["id", "title", "layout", "items"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
          "title": { "type": "string", "minLength": 1 },
          "subtitle": { "type": "string" },
          "palette": { "type": "string" },
          "layout": { "enum": ["full", "chip_row", "zone_grid"] },
          "actionPrompt": { "type": "string" },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/item" }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "paletteEntry": {
      "type": "object",
      "required": ["id", "fill", "stroke", "title", "text"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
        "fill": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "stroke": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "title": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "text": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
      },
      "additionalProperties": false
    },
    "item": {
      "type": "object",
      "required": ["id", "title"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
        "title": { "type": "string", "minLength": 1 },
        "subtitle": { "type": "string" },
        "details": { "type": "array", "items": { "type": "string" } },
        "palette": { "type": "string" },
        "actionPrompt": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
