{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/svgflow/flow-dsl.schema.json",
  "title": "SVGFlow Flow DSL",
  "type": "object",
  "required": [
    "meta",
    "style",
    "nodes",
    "edges"
  ],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "title",
        "description",
        "diagramType",
        "direction",
        "mode",
        "locale",
        "textDirection"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "diagramType": {
          "type": "string",
          "enum": [
            "flowchart"
          ]
        },
        "direction": {
          "type": "string",
          "enum": [
            "TB",
            "LR"
          ]
        },
        "mode": {
          "type": "string",
          "enum": [
            "preview_svg",
            "raw_svg",
            "html_preview",
            "component_ready"
          ]
        },
        "locale": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
        },
        "textDirection": {
          "type": "string",
          "enum": [
            "ltr",
            "rtl",
            "auto"
          ]
        }
      }
    },
    "style": {
      "type": "object",
      "required": [
        "maxNodes",
        "colorLimit",
        "preferredColors"
      ],
      "additionalProperties": false,
      "properties": {
        "maxNodes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "colorLimit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "preferredColors": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "gray",
              "blue",
              "green",
              "amber",
              "coral",
              "purple",
              "teal"
            ]
          },
          "maxItems": 3
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "label",
          "color"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_\\-]*$"
          },
          "type": {
            "type": "string",
            "enum": [
              "start",
              "action",
              "decision",
              "end",
              "error"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16
          },
          "subtitle": {
            "type": "string",
            "maxLength": 12
          },
          "color": {
            "type": "string",
            "enum": [
              "gray",
              "blue",
              "green",
              "amber",
              "coral",
              "purple",
              "teal"
            ]
          },
          "lane": {
            "type": "string"
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to"
        ],
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16
          },
          "branch": {
            "type": "string",
            "enum": [
              "main",
              "left",
              "right"
            ]
          },
          "route": {
            "type": "string",
            "enum": [
              "straight",
              "l-shape",
              "loop-left",
              "loop-right"
            ]
          }
        }
      }
    }
  }
}
