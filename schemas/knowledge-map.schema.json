{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/svgflow/knowledge-map.schema.json",
  "title": "SVGFlow Knowledge Map DSL",
  "type": "object",
  "required": [
    "meta",
    "theme",
    "sections"
  ],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "title",
        "description",
        "diagramType",
        "mode",
        "locale",
        "textDirection",
        "viewBox"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "diagramType": {
          "const": "knowledge_map"
        },
        "mode": {
          "type": "string",
          "enum": [
            "preview_svg",
            "html_preview",
            "component_ready"
          ]
        },
        "locale": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
        },
        "textDirection": {
          "type": "string",
          "enum": [
            "ltr",
            "rtl",
            "auto"
          ]
        },
        "viewBox": {
          "type": "object",
          "required": [
            "width",
            "height"
          ],
          "additionalProperties": false,
          "properties": {
            "width": {
              "const": 680
            },
            "height": {
              "type": "integer",
              "minimum": 320,
              "maximum": 1200
            }
          }
        }
      }
    },
    "theme": {
      "type": "object",
      "required": [
        "background",
        "fontFamily",
        "palette"
      ],
      "additionalProperties": false,
      "properties": {
        "background": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "fontFamily": {
          "type": "string",
          "minLength": 1
        },
        "palette": {
          "type": "array",
          "minItems": 4,
          "maxItems": 12,
          "items": {
            "type": "object",
            "required": [
              "id",
              "fill",
              "stroke",
              "title",
              "text"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]*$"
              },
              "fill": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "stroke": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "title": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "text": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              }
            }
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 3,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "items"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "type": {
            "type": "string",
            "enum": [
              "header",
              "chapter_grid",
              "summary_grid",
              "footer"
            ]
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {
              "type": "object",
              "required": [
                "id",
                "title"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]*$"
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "subtitle": {
                  "type": "string",
                  "maxLength": 140
                },
                "palette": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]*$"
                },
                "actionPrompt": {
                  "type": "string",
                  "maxLength": 180
                }
              }
            }
          }
        }
      }
    }
  }
}
