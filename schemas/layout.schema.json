{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/svgflow/layout.schema.json",
  "title": "SVGFlow Layout DSL",
  "type": "object",
  "required": [
    "viewBox",
    "nodes",
    "connectors"
  ],
  "additionalProperties": false,
  "properties": {
    "viewBox": {
      "type": "object",
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "additionalProperties": false,
      "properties": {
        "x": {
          "const": 0
        },
        "y": {
          "const": 0
        },
        "width": {
          "const": 680
        },
        "height": {
          "type": "integer",
          "minimum": 120
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "shape",
          "x",
          "y"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "shape": {
            "type": "string",
            "enum": [
              "rect",
              "pill",
              "diamond"
            ]
          },
          "x": {
            "type": "number",
            "minimum": 0
          },
          "y": {
            "type": "number",
            "minimum": 0
          },
          "width": {
            "type": "number",
            "minimum": 1
          },
          "height": {
            "type": "number",
            "minimum": 1
          },
          "cx": {
            "type": "number"
          },
          "cy": {
            "type": "number"
          },
          "halfWidth": {
            "type": "number"
          },
          "halfHeight": {
            "type": "number"
          }
        }
      }
    },
    "connectors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "kind"
        ],
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "line",
              "path"
            ]
          },
          "label": {
            "type": "string"
          },
          "d": {
            "type": "string"
          }
        }
      }
    }
  }
}
