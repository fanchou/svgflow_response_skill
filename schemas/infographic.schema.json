{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/svgflow/infographic.schema.json",
  "title": "Universal Infographic DSL",
  "type": "object",
  "required": ["meta", "canvas", "content", "layout"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["title", "description", "diagramType", "mode", "locale", "textDirection"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "diagramType": { "const": "infographic" },
        "mode": { "enum": ["preview_svg", "raw_svg", "html_preview", "component_ready"] },
        "locale": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$" },
        "textDirection": { "enum": ["ltr", "rtl", "auto"] }
      },
      "additionalProperties": false
    },
    "canvas": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": { "enum": [680, 690] },
        "height": { "type": "integer", "minimum": 240, "maximum": 1600 },
        "background": { "type": "string" }
      },
      "additionalProperties": false
    },
    "content": {
      "type": "object",
      "required": ["nodes", "edges"],
      "properties": {
        "nodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 40,
          "items": { "$ref": "#/$defs/node" }
        },
        "groups": {
          "type": "array",
          "items": { "$ref": "#/$defs/group" }
        },
        "edges": {
          "type": "array",
          "items": { "$ref": "#/$defs/edge" }
        },
        "labels": {
          "type": "array",
          "items": { "$ref": "#/$defs/label" }
        },
        "legends": {
          "type": "array",
          "items": { "$ref": "#/$defs/legend" }
        },
        "steps": {
          "type": "array",
          "items": { "$ref": "#/$defs/step" }
        }
      },
      "additionalProperties": false
    },
    "layout": {
      "type": "object",
      "required": ["intent"],
      "properties": {
        "intent": {
          "enum": ["linear", "layered", "loop", "matrix", "hub_spoke", "timeline", "swimlane", "comparison", "hierarchy", "dashboard", "freeform"]
        },
        "direction": { "enum": ["TB", "BT", "LR", "RL", "radial"] },
        "density": { "enum": ["compact", "standard", "detailed"] },
        "nodeLimit": { "type": "integer", "minimum": 1, "maximum": 40 }
      },
      "additionalProperties": false
    },
    "style": {
      "type": "object",
      "properties": {
        "archetype": { "enum": ["dark_layered_architecture"] },
        "palette": { "type": "array", "items": { "type": "string" } },
        "theme": { "enum": ["official_dark", "light", "host_native"] },
        "cornerRadius": { "type": "number", "minimum": 0, "maximum": 16 }
      },
      "additionalProperties": false
    },
    "interactions": {
      "type": "array",
      "items": { "$ref": "#/$defs/interaction" }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": ["id", "title"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
        "title": { "type": "string", "minLength": 1 },
        "subtitle": { "type": "string" },
        "kind": { "enum": ["process", "decision", "entity", "container", "metric", "note", "output", "category", "risk", "recommendation", "evidence", "media"] },
        "tone": { "type": "string" },
        "parent": { "type": "string" },
        "items": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "group": {
      "type": "object",
      "required": ["id", "title", "members"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
        "title": { "type": "string", "minLength": 1 },
        "subtitle": { "type": "string" },
        "members": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "tone": { "type": "string" },
        "items": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "required": ["from", "to"],
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" },
        "label": { "type": "string" },
        "kind": { "enum": ["primary", "secondary", "feedback", "dependency", "data", "control", "contrast", "causal", "reference"] },
        "route": { "enum": ["straight", "orthogonal", "curved", "loop"] },
        "dashed": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "label": {
      "type": "object",
      "required": ["text"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "for": { "type": "string" },
        "tone": { "type": "string" }
      },
      "additionalProperties": false
    },
    "legend": {
      "type": "object",
      "required": ["label", "tone"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "tone": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "step": {
      "type": "object",
      "required": ["id", "title", "visibleNodes"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
        "title": { "type": "string", "minLength": 1 },
        "visibleNodes": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      },
      "additionalProperties": false
    },
    "interaction": {
      "type": "object",
      "required": ["target", "action"],
      "properties": {
        "target": { "type": "string" },
        "action": { "enum": ["sendPrompt", "step", "highlight", "toggle"] },
        "prompt": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
