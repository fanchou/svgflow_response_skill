{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/svgflow/walkthrough.schema.json",
  "title": "Interactive Walkthrough DSL",
  "type": "object",
  "required": ["meta", "theme", "steps"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["title", "description", "diagramType", "mode", "locale", "textDirection"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "diagramType": { "const": "interactive_walkthrough" },
        "mode": { "const": "html_preview" },
        "locale": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$" },
        "textDirection": { "enum": ["ltr", "rtl", "auto"] }
      },
      "additionalProperties": false
    },
    "theme": {
      "type": "object",
      "required": ["palette"],
      "properties": {
        "palette": {
          "type": "array",
          "minItems": 4,
          "maxItems": 12,
          "items": { "$ref": "#/$defs/paletteEntry" }
        }
      },
      "additionalProperties": false
    },
    "steps": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["id", "title", "label", "nodes", "connectors"],
        "properties": {
          "id": { "type": "string", "pattern": "^s\\d+$" },
          "title": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "animation": { "enum": ["none", "pulse", "travel", "pulse_travel"] },
          "nodes": {
            "type": "array",
            "minItems": 2,
            "items": { "$ref": "#/$defs/node" }
          },
          "connectors": {
            "type": "array",
            "items": { "$ref": "#/$defs/connector" }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "paletteEntry": {
      "type": "object",
      "required": ["id", "fill", "stroke", "title", "text"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
        "fill": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "stroke": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "title": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "text": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": ["id", "title", "palette"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
        "title": { "type": "string", "minLength": 1 },
        "subtitle": { "type": "string" },
        "palette": { "type": "string" }
      },
      "additionalProperties": false
    },
    "connector": {
      "type": "object",
      "required": ["from", "to"],
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" },
        "label": { "type": "string" },
        "animated": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
