{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/svgflow/phased-pipeline.schema.json",
  "title": "Phased Pipeline DSL",
  "type": "object",
  "required": ["meta", "spine", "phases"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["title", "description", "diagramType", "mode", "locale", "textDirection", "viewBox"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "diagramType": { "const": "phased_pipeline" },
        "mode": { "enum": ["preview_svg", "html_preview", "component_ready"] },
        "locale": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$" },
        "textDirection": { "enum": ["ltr", "rtl", "auto"] },
        "viewBox": {
          "type": "object",
          "required": ["width", "height"],
          "properties": {
            "width": { "const": 680 },
            "height": { "type": "integer", "minimum": 700, "maximum": 1400 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "spine": {
      "type": "array",
      "minItems": 3,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/node" }
    },
    "phases": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/phase" }
    },
    "sideNotes": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    },
    "legend": {
      "type": "array",
      "items": { "$ref": "#/$defs/legendItem" }
    },
    "footer": {
      "type": "string"
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": ["id", "title"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
        "title": { "type": "string", "minLength": 1 },
        "subtitle": { "type": "string" },
        "palette": { "type": "string" },
        "actionPrompt": { "type": "string" }
      },
      "additionalProperties": false
    },
    "phase": {
      "type": "object",
      "required": ["id", "title", "palette", "nodes"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
        "title": { "type": "string", "minLength": 1 },
        "palette": { "type": "string" },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/node" }
        },
        "localFlows": {
          "type": "array",
          "items": { "$ref": "#/$defs/localFlow" }
        }
      },
      "additionalProperties": false
    },
    "localFlow": {
      "type": "object",
      "required": ["from", "to"],
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" },
        "label": { "type": "string" }
      },
      "additionalProperties": false
    },
    "legendItem": {
      "type": "object",
      "required": ["label", "palette"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "palette": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
